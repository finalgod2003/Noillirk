{
  "name": "noillirk-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "worker:dev": "npm run build && wrangler dev",
    "check": "tsc -b",
    "test:p1": "node scripts/check-p1.mjs",
    "test:p2": "node scripts/check-p2.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run --outdir .wrangler-dist"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "wrangler": "^4.151.1"
  }
}
